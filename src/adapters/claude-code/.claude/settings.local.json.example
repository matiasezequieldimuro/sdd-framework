{
  "permissions": {
    "defaultMode": "default",
    "disableAutoMode": "disable",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Bash(sdd-cli status *)",
      "Bash(sdd-cli next *)",
      "Bash(sdd-cli validate *)",
      "Bash(sdd-cli adapters list)",
      "Edit(/.sdd/context/**)",
      "Edit(/.sdd/research/**)",
      "Edit(/.sdd/specs/**)",
      "Edit(/.sdd/work-items/active/**/artifacts/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git tag *)",
      "Bash(git remote *)",
      "Bash(git config *)",
      "Bash(gh pr create *)",
      "Bash(az repos pr create *)",
      "mcp__github__create_pull_request",
      "mcp__azure-devops__repo_pull_request_write"
    ],
    "deny": [
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv *)",
      "Bash(set)",
      "Bash(export)",
      "Bash(export *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(.envrc)",
      "Read(.npmrc)",
      "Read(.pypirc)",
      "Read(.netrc)",
      "Read(.git-credentials)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(*.kdbx)",
      "Read(secrets/**)",
      "Read(credentials/**)",
      "Read(.ssh/**)",
      "Read(.aws/**)",
      "Read(.claude/settings.local.json)",
      "Edit(/.claude/**)",
      "Edit(/.sdd/README.md)",
      "Edit(/.sdd/config.yaml)",
      "Edit(/.sdd/procedures/**)",
      "Edit(/.sdd/registry/**)",
      "Edit(/.sdd/schemas/**)",
      "Edit(/.sdd/templates/**)",
      "Edit(/.sdd/tests/**)",
      "Edit(/.sdd/workflows/**)",
      "Edit(/.sdd/work-items/archive/**)",
      "Edit(/.sdd/work-items/active/**/manifest.yaml)",
      "Edit(/.sdd/work-items/active/**/events.jsonl)"
    ]
  }
}