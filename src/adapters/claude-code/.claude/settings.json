{
  "permissions": {
    "defaultMode": "default",
    "disableAutoMode": "disable",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Bash(sdd-cli status *)",
      "Bash(sdd-cli next *)",
      "Bash(sdd-cli validate *)",
      "Bash(sdd-cli adapters list)",
      "Edit(/.sdd/context/**)",
      "Edit(/.sdd/research/**)",
      "Edit(/.sdd/specs/**)",
      "Edit(/.sdd/work-items/active/**/artifacts/**)",
      "Edit(/.sdd/work-items/active/**/evidence/**)",
      "Bash(npx --no-install playwright-cli *)",
      "Bash(playwright-cli *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git tag *)",
      "Bash(git remote *)",
      "Bash(git config *)",
      "Bash(git worktree *)",
      "Bash(gh pr create *)",
      "Bash(az repos pr create *)",
      "mcp__github__create_pull_request",
      "mcp__azure-devops__repo_pull_request_write",
      "Bash(npx --no-install playwright-cli *install*)",
      "Bash(playwright-cli *install*)",
      "Bash(npx --no-install playwright-cli *run-code*)",
      "Bash(playwright-cli *run-code*)",
      "Bash(npx --no-install playwright-cli *eval*)",
      "Bash(playwright-cli *eval*)",
      "Bash(npx --no-install playwright-cli *attach*)",
      "Bash(playwright-cli *attach*)",
      "Bash(npx --no-install playwright-cli *--extension*)",
      "Bash(playwright-cli *--extension*)",
      "Bash(npx --no-install playwright-cli *--cdp*)",
      "Bash(playwright-cli *--cdp*)",
      "Bash(npx --no-install playwright-cli *--profile*)",
      "Bash(playwright-cli *--profile*)",
      "Bash(npx --no-install playwright-cli *state-load*)",
      "Bash(playwright-cli *state-load*)",
      "Bash(npx --no-install playwright-cli *state-save*)",
      "Bash(playwright-cli *state-save*)",
      "Bash(npx --no-install playwright-cli *--filename*)",
      "Bash(playwright-cli *--filename*)"
    ],
    "deny": [
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv *)",
      "Bash(set)",
      "Bash(export)",
      "Bash(export *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(.envrc)",
      "Read(.npmrc)",
      "Read(.pypirc)",
      "Read(.netrc)",
      "Read(.git-credentials)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(*.kdbx)",
      "Read(secrets/**)",
      "Read(credentials/**)",
      "Read(.ssh/**)",
      "Read(.aws/**)",
      "Read(.claude/settings.local.json)",
      "Edit(/.claude/**)",
      "Edit(/.sdd/README.md)",
      "Edit(/.sdd/config.yaml)",
      "Edit(/.sdd/procedures/**)",
      "Edit(/.sdd/registry/**)",
      "Edit(/.sdd/schemas/**)",
      "Edit(/.sdd/templates/**)",
      "Edit(/.sdd/tests/**)",
      "Edit(/.sdd/workflows/**)",
      "Edit(/.sdd/work-items/archive/**)",
      "Edit(/.sdd/work-items/cancelled/**)",
      "Edit(/.sdd/work-items/active/**/manifest.yaml)",
      "Edit(/.sdd/work-items/active/**/events.jsonl)",
      "Bash(npx playwright-cli *)",
      "Bash(npx -y playwright-cli *)",
      "Bash(npx --yes playwright-cli *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-secrets.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-sdd-paths.py\""
          }
        ]
      }
    ]
  }
}